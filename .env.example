# Solana RPC endpoints (comma separated, first is primary)
RPC_ENDPOINTS=https://api.mainnet-beta.solana.com
RPC_WSS=wss://api.mainnet-beta.solana.com

# Jito block engine
JITO_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_TIP_LAMPORTS=10000

# Wallet
WALLET_KEYPAIR_PATH=./.wallets/hot.keypair.json

# Sniper strategy
SNIPE_AMOUNT_SOL=0.05
MAX_SLIPPAGE_BPS=1500
PRIORITY_FEE_MICROLAMPORTS=50000
DRY_RUN=true

# Risk filters
MIN_LIQUIDITY_SOL=5
MAX_TOP10_HOLDERS_PCT=45
REQUIRE_MINT_AUTHORITY_REVOKED=true